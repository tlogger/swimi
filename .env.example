# 카카오맵 JavaScript 앱 키
VITE_KAKAO_MAP_API_KEY=your_kakao_map_api_key_here

# Supabase 클라우드 중앙 DB 설정
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OAuth2 소셜 로그인 설정 (카카오, 네이버, 구글)
VITE_KAKAO_CLIENT_ID=your_kakao_client_id
VITE_KAKAO_CALLBACK_URL=https://tlogger.github.io/swimi/kakaologin

VITE_NAVER_CLIENT_ID=your_naver_client_id
VITE_NAVER_CLIENT_SECRET=your_naver_client_secret
VITE_NAVER_CALLBACK_URL=https://tlogger.github.io/swimi/naverlogin

VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CALLBACK_URL=https://tlogger.github.io/swimi/googlelogin
